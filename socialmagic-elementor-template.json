              "widgetType": "html",
              "settings": {
                "html": "<!-- HERO SECTION - Wklej ten kod w Elementor Custom HTML Widget -->\n\n<style>\n/* Hero Section Styles */\n.sm-hero-section {\n    position: relative;\n    min-height: 90vh;\n    display: flex;\n    align-items: center;\n    padding: 80px 20px;\n    overflow: hidden;\n    background: linear-gradient(135deg, #000000 0%, #0a0a0a 50%, #000000 100%);\n}\n\n/* Animated Background */\n.sm-hero-bg {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    z-index: 0;\n    overflow: hidden;\n}\n\n.sm-gradient-orb {\n    position: absolute;\n    border-radius: 50%;\n    filter: blur(100px);\n    opacity: 0.3;\n    animation: sm-float 20s infinite ease-in-out;\n}\n\n.sm-orb-1 {\n    width: 500px;\n    height: 500px;\n    background: radial-gradient(circle, rgba(191, 255, 0, 0.4) 0%, transparent 70%);\n    top: -250px;\n    left: -250px;\n    animation-delay: 0s;\n}\n\n.sm-orb-2 {\n    width: 400px;\n    height: 400px;\n    background: radial-gradient(circle, rgba(191, 255, 0, 0.3) 0%, transparent 70%);\n    top: 50%;\n    right: -200px;\n    animation-delay: 7s;\n}\n\n.sm-orb-3 {\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(191, 255, 0, 0.2) 0%, transparent 70%);\n    bottom: -300px;\n    left: 30%;\n    animation-delay: 14s;\n}\n\n@keyframes sm-float {\n    0%, 100% { transform: translate(0, 0) scale(1); }\n    33% { transform: translate(100px, -100px) scale(1.1); }\n    66% { transform: translate(-50px, 100px) scale(0.9); }\n}\n\n/* Content Container */\n.sm-hero-container {\n    max-width: 1280px;\n    margin: 0 auto;\n    width: 100%;\n    position: relative;\n    z-index: 1;\n}\n\n.sm-hero-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 80px;\n    align-items: center;\n}\n\n/* Hero Text */\n.sm-hero-text {\n    animation: sm-fadeInUp 1s ease-out;\n}\n\n@keyframes sm-fadeInUp {\n    from {\n        opacity: 0;\n        transform: translateY(40px);\n    }\n    to {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n.sm-label {\n    display: inline-block;\n    padding: 10px 24px;\n    background: rgba(191, 255, 0, 0.1);\n    border: 1px solid rgba(191, 255, 0, 0.3);\n    border-radius: 50px;\n    color: #BFFF00;\n    font-size: 13px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 1.5px;\n    margin-bottom: 24px;\n    backdrop-filter: blur(10px);\n}\n\n.sm-hero-title {\n    font-size: 64px;\n    font-weight: 900;\n    line-height: 1.1;\n    margin-bottom: 24px;\n    letter-spacing: -2px;\n    color: #ffffff;\n}\n\n.sm-gradient-text {\n    background: linear-gradient(135deg, #BFFF00 0%, #00FF87 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    display: inline-block;\n    position: relative;\n}\n\n.sm-hero-description {\n    font-size: 18px;\n    line-height: 1.8;\n    color: #cccccc;\n    margin-bottom: 16px;\n}\n\n.sm-hero-description strong {\n    color: #ffffff;\n    font-weight: 600;\n}\n\n.sm-hero-subtitle {\n    font-size: 16px;\n    line-height: 1.8;\n    color: #888888;\n    margin-bottom: 40px;\n}\n\n.sm-hero-cta {\n    display: flex;\n    gap: 16px;\n    align-items: center;\n    flex-wrap: wrap;\n}\n\n/* Button Styles */\n.sm-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    padding: 18px 36px;\n    border-radius: 50px;\n    font-size: 16px;\n    font-weight: 700;\n    text-decoration: none;\n    border: none;\n    cursor: pointer;\n    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n    position: relative;\n    overflow: hidden;\n}\n\n.sm-btn-primary {\n    background: #BFFF00;\n    color: #000000;\n    box-shadow: 0 10px 40px rgba(191, 255, 0, 0.3);\n}\n\n.sm-btn-primary:hover {\n    transform: translateY(-3px);\n    box-shadow: 0 20px 60px rgba(191, 255, 0, 0.5);\n}\n\n.sm-btn-arrow {\n    width: 20px;\n    height: 20px;\n    transition: transform 0.3s;\n}\n\n.sm-btn:hover .sm-btn-arrow {\n    transform: translateX(5px);\n}\n\n/* Hero Visual */\n.sm-hero-visual {\n    position: relative;\n    height: 600px;\n    animation: sm-fadeInUp 1s ease-out 0.3s backwards;\n}\n\n.sm-hero-image-wrapper {\n    position: relative;\n    width: 100%;\n    height: 100%;\n}\n\n.sm-hero-image {\n    width: 100%;\n    height: 100%;\n    border-radius: 24px;\n    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);\n    position: relative;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.sm-hero-image::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    background: radial-gradient(circle at 50% 50%, rgba(191, 255, 0, 0.1) 0%, transparent 70%);\n    animation: sm-rotate 10s linear infinite;\n}\n\n@keyframes sm-rotate {\n    from { transform: rotate(0deg); }\n    to { transform: rotate(360deg); }\n}\n\n/* Floating Cards */\n.sm-floating-card {\n    position: absolute;\n    padding: 20px 24px;\n    background: rgba(10, 10, 10, 0.9);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(191, 255, 0, 0.3);\n    border-radius: 16px;\n    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);\n    animation: sm-floating 3s infinite ease-in-out;\n}\n\n@keyframes sm-floating {\n    0%, 100% { transform: translateY(0px); }\n    50% { transform: translateY(-20px); }\n}\n\n.sm-stat-card-1 {\n    top: 80px;\n    left: -60px;\n    display: flex;\n    gap: 16px;\n    align-items: center;\n    animation-delay: 0s;\n}\n\n.sm-stat-card-2 {\n    top: 280px;\n    right: -60px;\n    display: flex;\n    gap: 16px;\n    align-items: center;\n    animation-delay: 1s;\n}\n\n.sm-stat-card-3 {\n    bottom: 100px;\n    left: -40px;\n    animation-delay: 2s;\n}\n\n.sm-stat-icon {\n    width: 48px;\n    height: 48px;\n    border-radius: 12px;\n    background: rgba(191, 255, 0, 0.15);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n}\n\n.sm-stat-icon svg {\n    width: 24px;\n    height: 24px;\n    stroke: #BFFF00;\n    stroke-width: 2;\n    fill: none;\n}\n\n.sm-stat-number {\n    font-size: 32px;\n    font-weight: 900;\n    color: #BFFF00;\n    line-height: 1;\n    margin-bottom: 4px;\n}\n\n.sm-stat-label {\n    font-size: 13px;\n    color: #888888;\n    line-height: 1.3;\n}\n\n/* Responsive */\n@media (max-width: 1024px) {\n    .sm-hero-grid {\n        grid-template-columns: 1fr;\n        gap: 60px;\n    }\n\n    .sm-hero-title {\n        font-size: 48px;\n    }\n\n    .sm-hero-visual {\n        height: 500px;\n    }\n}\n\n@media (max-width: 768px) {\n    .sm-hero-section {\n        padding: 60px 20px;\n        min-height: auto;\n    }\n\n    .sm-hero-title {\n        font-size: 36px;\n    }\n\n    .sm-hero-visual {\n        height: 400px;\n    }\n\n    .sm-floating-card {\n        position: static;\n        margin-bottom: 20px;\n    }\n\n    .sm-btn {\n        width: 100%;\n        justify-content: center;\n    }\n}\n</style>\n\n<!-- HTML Structure -->\n<div class=\"sm-hero-section\">\n    <!-- Animated Background -->\n    <div class=\"sm-hero-bg\">\n        <div class=\"sm-gradient-orb sm-orb-1\"></div>\n        <div class=\"sm-gradient-orb sm-orb-2\"></div>\n        <div class=\"sm-gradient-orb sm-orb-3\"></div>\n    </div>\n\n    <div class=\"sm-hero-container\">\n        <div class=\"sm-hero-grid\">\n            <!-- Hero Text -->\n            <div class=\"sm-hero-text\">\n                <span class=\"sm-label\">Dlaczego my?</span>\n                <h1 class=\"sm-hero-title\">\n                    Skuteczny marketing<br>\n                    internetowy dla<br>\n                    <span class=\"sm-gradient-text\">Twojej marki</span>\n                </h1>\n                <p class=\"sm-hero-description\">\n                    Zajmujemy się <strong>marketingiem internetowym</strong>, który działa. Tworzymy strony WWW, prowadzimy profile w social media, wdrażamy SEO i optymalizujemy wizytówki Google. Stawiamy na konkretne wyniki – większą widoczność, lepsze pozycje i realne konwersje.\n                </p>\n                <p class=\"sm-hero-subtitle\">\n                    Pracujemy z małymi firmami i lokalnymi biznesami, oferując elastyczne rozwiązania dopasowane do potrzeb. Jesteśmy niewielkim zespołem z doświadczeniem i podejściem skupionym na efekcie.\n                </p>\n                <div class=\"sm-hero-cta\">\n                    <a href=\"#kontakt\" class=\"sm-btn sm-btn-primary\">\n                        <span>Wypełnij formularz kontaktowy</span>\n                        <svg class=\"sm-btn-arrow\" viewBox=\"0 0 20 20\" fill=\"none\">\n                            <path d=\"M4 10h12m0 0l-6-6m6 6l-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n\n            <!-- Hero Visual -->\n            <div class=\"sm-hero-visual\">\n                <div class=\"sm-hero-image-wrapper\">\n                    <div class=\"sm-hero-image\">\n                        <!-- Tutaj możesz dodać zdjęcie przez Elementor lub zostaw pusty gradient -->\n                    </div>\n\n                    <!-- Floating Stats Cards -->\n                    <div class=\"sm-floating-card sm-stat-card-1\">\n                        <div class=\"sm-stat-icon\">\n                            <svg viewBox=\"0 0 24 24\">\n                                <path d=\"M12 2L2 7l10 5 10-5-10-5z\"/>\n                                <path d=\"M2 17l10 5 10-5M2 12l10 5 10-5\"/>\n                            </svg>\n                        </div>\n                        <div class=\"sm-stat-content\">\n                            <div class=\"sm-stat-number\">147</div>\n                            <div class=\"sm-stat-label\">Zadowolonych<br>klientów</div>\n                        </div>\n                    </div>\n\n                    <div class=\"sm-floating-card sm-stat-card-2\">\n                        <div class=\"sm-stat-icon\">\n                            <svg viewBox=\"0 0 24 24\">\n                                <path d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\"/>\n                            </svg>\n                        </div>\n                        <div class=\"sm-stat-content\">\n                            <div class=\"sm-stat-number\">10 000</div>\n                            <div class=\"sm-stat-label\">Wypozycjonowanych<br>fraz</div>\n                        </div>\n                    </div>\n\n                    <div class=\"sm-floating-card sm-stat-card-3\">\n                        <div class=\"sm-stat-icon\">\n                            <svg viewBox=\"0 0 24 24\">\n                                <path d=\"M13 10V3L4 14h7v7l9-11h-7z\"/>\n                            </svg>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\n// Counter Animation\ndocument.addEventListener('DOMContentLoaded', function() {\n    const counters = document.querySelectorAll('.sm-stat-number');\n\n    const animateCounter = (element, target) => {\n        let start = 0;\n        const duration = 2000;\n        const increment = target / (duration / 16);\n\n        const counter = setInterval(() => {\n            start += increment;\n            if (start >= target) {\n                element.textContent = target.toLocaleString('pl-PL');\n                clearInterval(counter);\n            } else {\n                element.textContent = Math.floor(start).toLocaleString('pl-PL');\n            }\n        }, 16);\n    };\n\n    const observer = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n            if (entry.isIntersecting && !entry.target.classList.contains('counted')) {\n                entry.target.classList.add('counted');\n                const targetValue = parseInt(entry.target.textContent.replace(/\\s/g, ''));\n                animateCounter(entry.target, targetValue);\n            }\n        });\n    }, { threshold: 0.5 });\n\n    counters.forEach(counter => observer.observe(counter));\n});\n</script>\n"
              },
              "elements": []
            }
          ]
        }
      ]
