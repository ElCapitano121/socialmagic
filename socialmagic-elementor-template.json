                "html": "<!-- PRICING SECTION - Wklej ten kod w Elementor Custom HTML Widget -->\n\n<style>\n.sm-pricing-section {\n    padding: 120px 20px;\n    background: linear-gradient(180deg, #000000 0%, #0a0a0a 100%);\n    position: relative;\n}\n\n.sm-pricing-container {\n    max-width: 1280px;\n    margin: 0 auto;\n}\n\n.sm-pricing-header {\n    text-align: center;\n    margin-bottom: 80px;\n}\n\n.sm-pricing-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 40px;\n    margin-top: 60px;\n}\n\n.sm-pricing-card {\n    padding: 48px 40px;\n    background: rgba(10, 10, 10, 0.8);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(191, 255, 0, 0.15);\n    border-radius: 24px;\n    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);\n    position: relative;\n    overflow: hidden;\n}\n\n.sm-pricing-card::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 4px;\n    background: linear-gradient(90deg, #BFFF00, #00FF87);\n    transform: scaleX(0);\n    transition: transform 0.6s;\n}\n\n.sm-pricing-card:hover::before {\n    transform: scaleX(1);\n}\n\n.sm-pricing-card.featured {\n    border-color: #BFFF00;\n    box-shadow: 0 30px 80px rgba(191, 255, 0, 0.2);\n}\n\n.sm-pricing-card:hover {\n    transform: translateY(-10px);\n    border-color: #BFFF00;\n    box-shadow: 0 40px 100px rgba(191, 255, 0, 0.25);\n}\n\n.sm-featured-badge {\n    position: absolute;\n    top: 24px;\n    right: 24px;\n    padding: 8px 20px;\n    background: #BFFF00;\n    color: #000000;\n    font-size: 11px;\n    font-weight: 900;\n    border-radius: 50px;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n}\n\n.sm-pricing-card h3 {\n    font-size: 28px;\n    font-weight: 800;\n    margin-bottom: 12px;\n    color: #ffffff;\n}\n\n.sm-pricing-desc {\n    font-size: 15px;\n    line-height: 1.7;\n    color: #888888;\n    margin-bottom: 32px;\n}\n\n.sm-price {\n    display: flex;\n    align-items: baseline;\n    gap: 8px;\n    margin-bottom: 32px;\n    padding-bottom: 32px;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.sm-price-label {\n    font-size: 16px;\n    color: #888888;\n}\n\n.sm-price-value {\n    font-size: 56px;\n    font-weight: 900;\n    color: #BFFF00;\n    line-height: 1;\n}\n\n.sm-price-period {\n    font-size: 18px;\n    color: #888888;\n}\n\n.sm-pricing-features {\n    list-style: none;\n    margin-bottom: 32px;\n}\n\n.sm-pricing-features li {\n    padding: 14px 0;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n    font-size: 14px;\n    color: #cccccc;\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    line-height: 1.6;\n}\n\n.sm-pricing-features li::before {\n    content: '✓';\n    color: #BFFF00;\n    font-weight: bold;\n    font-size: 16px;\n    flex-shrink: 0;\n}\n\n.sm-pricing-btn {\n    width: 100%;\n    padding: 18px 32px;\n    background: transparent;\n    border: 2px solid rgba(191, 255, 0, 0.3);\n    border-radius: 50px;\n    color: #BFFF00;\n    font-size: 15px;\n    font-weight: 700;\n    text-align: center;\n    text-decoration: none;\n    display: block;\n    transition: all 0.4s;\n}\n\n.sm-pricing-btn:hover {\n    background: #BFFF00;\n    color: #000000;\n    border-color: #BFFF00;\n    transform: translateY(-2px);\n    box-shadow: 0 10px 40px rgba(191, 255, 0, 0.3);\n}\n\n.sm-pricing-card.featured .sm-pricing-btn {\n    background: #BFFF00;\n    color: #000000;\n    border-color: #BFFF00;\n}\n\n.sm-pricing-card.featured .sm-pricing-btn:hover {\n    background: transparent;\n    color: #BFFF00;\n    box-shadow: none;\n}\n\n@media (max-width: 1024px) {\n    .sm-pricing-grid {\n        grid-template-columns: 1fr;\n    }\n}\n\n@media (max-width: 768px) {\n    .sm-pricing-section {\n        padding: 80px 20px;\n    }\n\n    .sm-pricing-card {\n        padding: 32px 24px;\n    }\n\n    .sm-price-value {\n        font-size: 42px;\n    }\n}\n</style>\n\n<div class=\"sm-pricing-section\">\n    <div class=\"sm-pricing-container\">\n        <div class=\"sm-pricing-header\">\n            <span class=\"sm-section-label\">Przystępne Plany</span>\n            <h2 class=\"sm-section-title\">\n                Przystępne plany <span class=\"sm-gradient-text\">dla rozwoju</span> Twojej firmy\n            </h2>\n        </div>\n\n        <div class=\"sm-pricing-grid\">\n            <!-- Pricing Card 1 -->\n            <div class=\"sm-pricing-card\">\n                <h3>Social Media</h3>\n                <p class=\"sm-pricing-desc\">\n                    Dla firm, które chcą aktywnie budować relacje w social mediach dzięki regularnej treści, reelsei i optymalizacji profilu.\n                </p>\n                <div class=\"sm-price\">\n                    <span class=\"sm-price-label\">PLN</span>\n                    <span class=\"sm-price-value\">650</span>\n                    <span class=\"sm-price-period\">/msc</span>\n                </div>\n                <ul class=\"sm-pricing-features\">\n                    <li>Szczegóły pakietu w zakładce Cennik</li>\n                    <li>Obsługa Klienta 24/7</li>\n                    <li>Optymalizacja profili i treści</li>\n                    <li>5 postów miesięcznie (grafika + text)</li>\n                    <li>4 relacje miesięcznie</li>\n                    <li>Responsywność relacji (24-48h zależnie)</li>\n                    <li>Profesjonalne zdjęcia w treści (zewis)</li>\n                    <li>Publikacja treści (wewnęz na Instagram)</li>\n                </ul>\n                <a href=\"#kontakt\" class=\"sm-pricing-btn\">Formularz Kontaktowy</a>\n            </div>\n\n            <!-- Pricing Card 2 - Featured -->\n            <div class=\"sm-pricing-card featured\">\n                <div class=\"sm-featured-badge\">Polecane</div>\n                <h3>Pozycjonowanie Lokalne SEO / AIO</h3>\n                <p class=\"sm-pricing-desc\">\n                    Dla firm lokalnych, które chcą być widoczne w Google na frazy regionalne i w mapach Google Business.\n                </p>\n                <div class=\"sm-price\">\n                    <span class=\"sm-price-label\">od</span>\n                    <span class=\"sm-price-value\">890zł</span>\n                    <span class=\"sm-price-period\">/msc</span>\n                </div>\n                <ul class=\"sm-pricing-features\">\n                    <li>Szczegóły pakietu w zakładce Cennik</li>\n                    <li>2 zoptymalizowane wpisy blogowe (miesięcznie thematy lokalne lub branżowe)</li>\n                    <li>Audyt techniczny strony (pod przyszłek struktury, lokalizacyją)</li>\n                    <li>Pozycjonowanie wizytówki Google (Google Business Profile)</li>\n                    <li>Publikacja jakościowych artykułów sponsorowanych (1 linkas)</li>\n                    <li>Skala analityki fraz kluczowych i konkurencji (bez limitu stiku)</li>\n                    <li>Pełna konfiguracja Google Search Console, Analytics, GA4, Tag Manager</li>\n                </ul>\n                <a href=\"#kontakt\" class=\"sm-pricing-btn\">Formularz Kontaktowy</a>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n    const pricingCards = document.querySelectorAll('.sm-pricing-card');\n\n    const observer = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n            if (entry.isIntersecting) {\n                entry.target.style.opacity = '1';\n                entry.target.style.transform = 'translateY(0)';\n            }\n        });\n    }, { threshold: 0.1 });\n\n    pricingCards.forEach((card, index) => {\n        card.style.opacity = '0';\n        card.style.transform = 'translateY(50px)';\n        card.style.transition = `all 0.8s ease ${index * 0.2}s`;\n        observer.observe(card);\n    });\n});\n</script>\n"
