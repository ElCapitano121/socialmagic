            {
              "id": "k2n50l3",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<!-- DLACZEGO MY SECTION - Wklej ten kod w Elementor Custom HTML Widget -->\n\n<style>\n.sm-why-us-section {\n    padding: 120px 20px;\n    background: #000000;\n    position: relative;\n    overflow: hidden;\n}\n\n.sm-why-container {\n    max-width: 1280px;\n    margin: 0 auto;\n}\n\n.sm-section-header {\n    text-align: center;\n    margin-bottom: 80px;\n}\n\n.sm-section-label {\n    display: inline-block;\n    padding: 10px 24px;\n    background: rgba(191, 255, 0, 0.1);\n    border: 1px solid rgba(191, 255, 0, 0.3);\n    border-radius: 50px;\n    color: #BFFF00;\n    font-size: 12px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 1.5px;\n    margin-bottom: 20px;\n}\n\n.sm-section-title {\n    font-size: 56px;\n    font-weight: 900;\n    line-height: 1.15;\n    color: #ffffff;\n    letter-spacing: -1.5px;\n}\n\n.sm-why-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 32px;\n}\n\n.sm-why-card {\n    padding: 48px 40px;\n    background: rgba(10, 10, 10, 0.6);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(191, 255, 0, 0.15);\n    border-radius: 24px;\n    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);\n    position: relative;\n    overflow: hidden;\n}\n\n.sm-why-card::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    background: radial-gradient(circle at 50% 50%, rgba(191, 255, 0, 0.1) 0%, transparent 70%);\n    opacity: 0;\n    transition: opacity 0.6s;\n}\n\n.sm-why-card:hover {\n    transform: translateY(-15px);\n    border-color: #BFFF00;\n    box-shadow: 0 30px 80px rgba(191, 255, 0, 0.25);\n}\n\n.sm-why-card:hover::before {\n    opacity: 1;\n}\n\n.sm-card-icon {\n    width: 64px;\n    height: 64px;\n    background: rgba(191, 255, 0, 0.15);\n    border-radius: 16px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 28px;\n    position: relative;\n    z-index: 1;\n    transition: all 0.4s;\n}\n\n.sm-why-card:hover .sm-card-icon {\n    background: rgba(191, 255, 0, 0.3);\n    transform: scale(1.1) rotate(5deg);\n}\n\n.sm-card-icon svg {\n    width: 32px;\n    height: 32px;\n    stroke: #BFFF00;\n    stroke-width: 2.5;\n    fill: none;\n}\n\n.sm-why-card h3 {\n    font-size: 22px;\n    font-weight: 700;\n    line-height: 1.4;\n    margin-bottom: 16px;\n    color: #ffffff;\n    position: relative;\n    z-index: 1;\n}\n\n.sm-why-card p {\n    font-size: 15px;\n    line-height: 1.8;\n    color: #888888;\n    position: relative;\n    z-index: 1;\n}\n\n.sm-why-center {\n    grid-column: 2 / 3;\n    grid-row: 1 / 3;\n    padding: 0;\n    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n}\n\n.sm-center-glow {\n    width: 250px;\n    height: 250px;\n    background: radial-gradient(circle, rgba(191, 255, 0, 0.4) 0%, transparent 70%);\n    animation: sm-pulse-glow 4s infinite ease-in-out;\n}\n\n@keyframes sm-pulse-glow {\n    0%, 100% {\n        transform: scale(1);\n        opacity: 0.6;\n    }\n    50% {\n        transform: scale(1.5);\n        opacity: 0.3;\n    }\n}\n\n@media (max-width: 1024px) {\n    .sm-why-grid {\n        grid-template-columns: 1fr;\n    }\n\n    .sm-why-center {\n        grid-column: 1;\n        grid-row: auto;\n        min-height: 400px;\n    }\n\n    .sm-section-title {\n        font-size: 42px;\n    }\n}\n\n@media (max-width: 768px) {\n    .sm-why-us-section {\n        padding: 80px 20px;\n    }\n\n    .sm-section-title {\n        font-size: 32px;\n    }\n\n    .sm-why-card {\n        padding: 32px 24px;\n    }\n}\n</style>\n\n<div class=\"sm-why-us-section\">\n    <div class=\"sm-why-container\">\n        <div class=\"sm-section-header\">\n            <span class=\"sm-section-label\">Dlaczego my?</span>\n            <h2 class=\"sm-section-title\">\n                Jedna ekipa od całego <span class=\"sm-gradient-text\">digitalu</span>\n            </h2>\n        </div>\n\n        <div class=\"sm-why-grid\">\n            <!-- Card 1 -->\n            <div class=\"sm-why-card\">\n                <div class=\"sm-card-icon\">\n                    <svg viewBox=\"0 0 40 40\">\n                        <path d=\"M8 12h24M8 20h24M8 28h12\" stroke-linecap=\"round\"/>\n                    </svg>\n                </div>\n                <h3>Strategie marketingowe skrojone na Twój biznes</h3>\n                <p>Tworzymy strategie marketingowe online, które odpowiadają na potrzeby Twojej branży. Działania są dostosowane do celów i klientów. Skuteczny marketing internetowy zaczyna się od przemyślanej strategii dopasowanej do rynku.</p>\n            </div>\n\n            <!-- Card 2 -->\n            <div class=\"sm-why-card\">\n                <div class=\"sm-card-icon\">\n                    <svg viewBox=\"0 0 40 40\">\n                        <circle cx=\"20\" cy=\"20\" r=\"15\"/>\n                        <path d=\"M20 15v5l3 3\" stroke-linecap=\"round\"/>\n                    </svg>\n                </div>\n                <h3>Audyt Stron</h3>\n                <p>Identyfikujemy błędy i niewykorzystany potencjał Twojej strony www.</p>\n            </div>\n\n            <!-- Center Visual -->\n            <div class=\"sm-why-card sm-why-center\">\n                <div class=\"sm-center-glow\"></div>\n            </div>\n\n            <!-- Card 3 -->\n            <div class=\"sm-why-card\">\n                <div class=\"sm-card-icon\">\n                    <svg viewBox=\"0 0 40 40\">\n                        <path d=\"M10 30l8-8m0 0l8-8m-8 8l8 8m-8-8l-8-8\" stroke-linecap=\"round\"/>\n                    </svg>\n                </div>\n                <h3>Marketing, który przynosi wyniki w liczbach</h3>\n                <p>Testujemy, analizujemy i optymalizujemy każdą kampanię. Nasz marketing online wpływa na zasięg, widoczność i konwersję. Działania reklamowe są prowadzone z myślą o mierzalnych efektach dla Twojego biznesu.</p>\n            </div>\n\n            <!-- Card 4 -->\n            <div class=\"sm-why-card\">\n                <div class=\"sm-card-icon\">\n                    <svg viewBox=\"0 0 40 40\">\n                        <rect x=\"8\" y=\"8\" width=\"24\" height=\"24\" rx=\"4\"/>\n                        <path d=\"M15 20l3 3 7-7\" stroke-linecap=\"round\"/>\n                    </svg>\n                </div>\n                <h3>Pełna obsługa marketingu online</h3>\n                <p>Prowadzimy kompleksowy marketing internetowy: od budowy marki i treści, przez reklamy i strony WWW, aż po SEO i optymalizację wizytówek Google. Działamy spójnie, efektywnie i zorientowani na rozwój Twojej widoczności.</p>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n    const cards = document.querySelectorAll('.sm-why-card');\n\n    const observer = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n            if (entry.isIntersecting) {\n                entry.target.style.opacity = '1';\n                entry.target.style.transform = 'translateY(0)';\n            }\n        });\n    }, { threshold: 0.1 });\n\n    cards.forEach((card, index) => {\n        card.style.opacity = '0';\n        card.style.transform = 'translateY(40px)';\n        card.style.transition = `opacity 0.8s ease ${index * 0.1}s, transform 0.8s ease ${index * 0.1}s`;\n        observer.observe(card);\n    });\n});\n</script>\n"
              },
